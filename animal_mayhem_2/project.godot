[layer_names]
3d_physics/layer_1="world"
3d_physics/layer_2="buffalo"
3d_physics/layer_3="monkey"
3d_physics/layer_4="snake"

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.22, 0.32, 0.28, 1)

[android]
package="com.animalmayhem.adventure"
permissions/vibrate=false
